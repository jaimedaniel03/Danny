{
  "name": "danny",
  "version": "0.1.0",
  "private": true,
  "description": "An AI producer for insurance agencies \u2014 compliant voice outreach for Home, Auto, Business, Health, and Life.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "compliance:selftest": "vitest run src/compliance --reporter=verbose",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "voice:enroll": "tsx scripts/enroll-voice.ts",
    "call:dry": "tsx scripts/dry-call.ts",
    "leads:triage": "tsx scripts/triage-leads.ts",
    "leads:links": "tsx scripts/consent-links.ts",
    "media": "tsx scripts/media-server.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@deepgram/sdk": "^4.11.2",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "twilio": "^5.10.2",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/ws": "^8.18.1",
    "eslint": "^9.36.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
