{
  "name": "danny",
  "version": "0.1.0",
  "private": true,
  "description": "All Set Check (life and health insurance website + private lead desk) and Danny (compliant AI voice outreach), on one Next.js codebase.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "compliance:selftest": "vitest run src/compliance --reporter=verbose",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "voice:enroll": "tsx scripts/enroll-voice.ts",
    "call:dry": "tsx scripts/dry-call.ts",
    "leads:triage": "tsx scripts/triage-leads.ts",
    "leads:links": "tsx scripts/consent-links.ts",
    "media": "tsx scripts/media-server.ts",
    "setup": "tsx scripts/setup.ts",
    "book:analyze": "tsx scripts/analyze-book.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:db": "TEST_DATABASE_ADMIN_URL=${TEST_DATABASE_ADMIN_URL:-postgres://postgres:postgres@127.0.0.1:5432/postgres} vitest run",
    "e2e": "playwright test",
    "images:build": "tsx scripts/build-images.ts",
    "brand:build": "tsx scripts/brand-assets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@deepgram/sdk": "^4.11.2",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.4",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "twilio": "^5.10.2",
    "uqr": "0.1.3",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.36.0",
    "opentype.js": "^1.3.4",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
