# ─────────────────────────────────────────────────────────────
# Danny — environment
# Copy to .env.local. Never commit the filled version.
# ─────────────────────────────────────────────────────────────

# ── Telephony ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your DID in E.164. This is the number prospects see and call back.
TWILIO_CALLER_ID=+1XXXXXXXXXX
# Public base URL Twilio posts webhooks to (ngrok in dev, Vercel in prod)
PUBLIC_BASE_URL=https://danny.example.com
# Shared secret we append to webhook URLs, checked alongside Twilio signature
TWILIO_WEBHOOK_SECRET=

# ── Voice: TTS (Fish Audio — cloned voice) ───────────────────
FISH_API_KEY=
# The model/voice id returned when you enrolled the reference audio
FISH_VOICE_MODEL_ID=
FISH_API_BASE=https://api.fish.audio
# Fallback TTS if Fish is degraded or over latency budget
FALLBACK_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Voice: STT ───────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ── Brain ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Turn-by-turn conversational model (latency-sensitive)
DANNY_TURN_MODEL=claude-opus-5
# Post-call analysis + coaching (quality-sensitive, not latency-sensitive)
DANNY_ANALYSIS_MODEL=claude-opus-5
# Turn effort. "low" is the right setting for live phone turns; raise only
# if you measure a quality problem. Thinking stays adaptive either way.
DANNY_TURN_EFFORT=low

# ── Data ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Compliance ───────────────────────────────────────────────
# National DNC Registry SAN (subscription account number). Required for outbound.
DNC_SAN=
DNC_ORG_ID=
# Litigator / serial-plaintiff scrub (Blacklist Alliance, DNC.com, etc.)
LITIGATOR_SCRUB_PROVIDER=
LITIGATOR_SCRUB_API_KEY=
# NOTE: licensed states, license classes, agency legal name, NPN, postal address,
# producers and sender identity are NOT env vars. They live in agency.config.json,
# written by `npm run setup` and validated on every load — because a typo in a
# licensed state is a legal problem, not a config problem, and a validated file
# catches it where a loose env var cannot.

# ── CRM & GTM connectors ─────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
APOLLO_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Ops ──────────────────────────────────────────────────────
NODE_ENV=development
# Set to "true" only in CI/test. When true, the dialer resolves to a loopback sink
# and can never reach the PSTN.
DANNY_DRY_RUN=true
LOG_LEVEL=info

# ── Consent capture ──────────────────────────────────────────
# Signs consent link tokens. Min 32 chars. Rotating it invalidates every
# unsent link, so generate once and keep it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONSENT_TOKEN_SECRET=
AGENCY_ID=
# Local development only. Lets the consent form render disclosure language
# that counsel has not signed off on. NEVER set this in production — consent
# captured under unreviewed text may be void.
DANNY_ALLOW_DRAFT_DISCLOSURE=false

# ── Media server ─────────────────────────────────────────────
# The voice loop needs a persistent WebSocket process; Vercel cannot host it.
# Run it on Fly.io / Railway / a container and point PUBLIC_BASE_URL here.
MEDIA_SERVER_PORT=8080
PRODUCER_TRANSFER_NUMBER=
PRODUCER_NAME=

# ── SMS (text) ───────────────────────────────────────────────
# A Messaging Service attached to a REGISTERED A2P 10DLC Brand + Campaign.
# Unregistered A2P traffic is silently filtered by US carriers: messages look
# sent and never arrive. Register before your first real send.
TWILIO_MESSAGING_SERVICE_SID=

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=

# Sender identity and the CAN-SPAM postal address come from agency.config.json.
# These four override it, for the case where one profile sends from more than
# one address. Leave them blank unless you need that.
#
# Use a dedicated sending domain with SPF, DKIM and DMARC. Volume from a
# personal Gmail burns the domain on the first campaign.
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
# CAN-SPAM requires a physical postal address in every commercial email.
# A PO box is acceptable. Nothing is not — sends are refused without it.
AGENCY_POSTAL_ADDRESS=
