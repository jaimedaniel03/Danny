constraint allset.audit_events audit_events_action_check c CHECKchar_lengthaction<=64
constraint allset.audit_events audit_events_actor_id_fkey f FOREIGNKEYactor_idREFERENCESallset.staff_usersidONDELETERESTRICT
constraint allset.audit_events audit_events_entity_ref_check c CHECKentity_refISNULLORchar_lengthentity_ref<=32
constraint allset.audit_events audit_events_entity_type_check c CHECKentity_typeISNULLORchar_lengthentity_type<=32
constraint allset.audit_events audit_events_pkey p PRIMARYKEYid
constraint allset.contact_suppressions contact_suppressions_basis_check c CHECKbasis=ANYARRAY['explicit_opt_out'::text,'counsel_approved_retention'::text]
constraint allset.contact_suppressions contact_suppressions_created_by_fkey f FOREIGNKEYcreated_byREFERENCESallset.staff_usersidONDELETESETNULL
constraint allset.contact_suppressions contact_suppressions_kind_check c CHECKkind=ANYARRAY['email'::text,'phone'::text]
constraint allset.contact_suppressions contact_suppressions_pkey p PRIMARYKEYvalue_hash
constraint allset.contact_suppressions contact_suppressions_value_hash_check c CHECKchar_lengthvalue_hash<=128
constraint allset.inquiries inquiries_consent_channels_check c CHECKcardinalityconsent_channels>=1ANDcardinalityconsent_channels<=3ANDconsent_channels<@ARRAY['email'::text,'phone'::text,'text'::text]
constraint allset.inquiries inquiries_idempotency_key_key u UNIQUEidempotency_key
constraint allset.inquiries inquiries_kind_check c CHECKkind=ANYARRAY['coverage'::text,'team'::text]
constraint allset.inquiries inquiries_lead_id_fkey f FOREIGNKEYlead_idREFERENCESallset.leadsidONDELETECASCADE
constraint allset.inquiries inquiries_pkey p PRIMARYKEYid
constraint allset.inquiries inquiries_reference_check c CHECKreference~'^ASC-[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$'::text
constraint allset.inquiries inquiries_reference_key u UNIQUEreference
constraint allset.inquiries inquiries_source_path_check c CHECKchar_lengthsource_path<=200
constraint allset.inquiries inquiries_user_agent_check c CHECKuser_agentISNULLORchar_lengthuser_agent<=256
constraint allset.lead_notes lead_notes_author_id_fkey f FOREIGNKEYauthor_idREFERENCESallset.staff_usersidONDELETERESTRICT
constraint allset.lead_notes lead_notes_body_check c CHECKchar_lengthbody>=1ANDchar_lengthbody<=4000
constraint allset.lead_notes lead_notes_lead_id_fkey f FOREIGNKEYlead_idREFERENCESallset.leadsidONDELETECASCADE
constraint allset.lead_notes lead_notes_pkey p PRIMARYKEYid
constraint allset.leads closed_at_matches_status c CHECKstatus=ANYARRAY['closed_helped'::text,'closed_no_action'::text,'do_not_contact'::text]=closed_atISNOTNULL
constraint allset.leads leads_assigned_to_fkey f FOREIGNKEYassigned_toREFERENCESallset.staff_usersidONDELETESETNULL
constraint allset.leads leads_contact_method_check c CHECKcontact_method=ANYARRAY['email'::text,'phone'::text,'text'::text]
constraint allset.leads leads_coverage_interest_check c CHECKcoverage_interest=ANYARRAY['life'::text,'health'::text,'both'::text,'not_sure'::text]
constraint allset.leads leads_email_check c CHECKchar_lengthemail>=3ANDchar_lengthemail<=254
constraint allset.leads leads_email_normalized_check c CHECKchar_lengthemail_normalized>=3ANDchar_lengthemail_normalized<=254
constraint allset.leads leads_full_name_check c CHECKchar_lengthfull_name>=2ANDchar_lengthfull_name<=100
constraint allset.leads leads_kind_check c CHECKkind=ANYARRAY['coverage'::text,'team'::text]
constraint allset.leads leads_licensing_status_check c CHECKlicensing_status=ANYARRAY['licensed_life_health'::text,'licensed_other'::text,'studying'::text,'not_licensed'::text]
constraint allset.leads leads_phone_e164_check c CHECKphone_e164ISNULLORphone_e164~'^\+1[2-9][0-9]{2}[2-9][0-9]{6}$'::text
constraint allset.leads leads_pkey p PRIMARYKEYid
constraint allset.leads leads_state_check c CHECKstate~'^[A-Z]{2}$'::text
constraint allset.leads leads_status_check c CHECKstatus=ANYARRAY['new'::text,'contacted'::text,'meeting_scheduled'::text,'following_up'::text,'closed_helped'::text,'closed_no_action'::text,'do_not_contact'::text]
constraint allset.leads leads_submission_count_check c CHECKsubmission_count>=1
constraint allset.leads leads_zip_check c CHECKzip~'^[0-9]{5}$'::text
constraint allset.leads phone_matches_method c CHECKcontact_method='email'::textORphone_e164ISNOTNULL
constraint allset.leads qualifier_matches_kind c CHECKkind='coverage'::textANDcoverage_interestISNOTNULLANDlicensing_statusISNULLORkind='team'::textANDlicensing_statusISNOTNULLANDcoverage_interestISNULL
constraint allset.notification_recipients notification_recipients_added_by_fkey f FOREIGNKEYadded_byREFERENCESallset.staff_usersidONDELETESETNULL
constraint allset.notification_recipients notification_recipients_confirm_token_hash_key u UNIQUEconfirm_token_hash
constraint allset.notification_recipients notification_recipients_email_check c CHECKchar_lengthemail>=3ANDchar_lengthemail<=254
constraint allset.notification_recipients notification_recipients_pkey p PRIMARYKEYid
constraint allset.notifications notifications_kind_check c CHECKkind=ANYARRAY['lead_received'::text,'recipient_confirmation'::text,'test_alert'::text]
constraint allset.notifications notifications_last_error_check c CHECKlast_errorISNULLORchar_lengthlast_error<=300
constraint allset.notifications notifications_lead_id_fkey f FOREIGNKEYlead_idREFERENCESallset.leadsidONDELETESETNULL
constraint allset.notifications notifications_pkey p PRIMARYKEYid
constraint allset.notifications notifications_provider_message_id_key u UNIQUEprovider_message_id
constraint allset.notifications notifications_recipient_id_fkey f FOREIGNKEYrecipient_idREFERENCESallset.notification_recipientsidONDELETECASCADE
constraint allset.notifications notifications_status_check c CHECKstatus=ANYARRAY['pending'::text,'sending'::text,'sent'::text,'delayed'::text,'delivered'::text,'bounced'::text,'failed'::text,'canceled'::text]
constraint allset.rate_limits rate_limits_bucket_check c CHECKchar_lengthbucket<=64
constraint allset.rate_limits rate_limits_key_hash_check c CHECKchar_lengthkey_hash<=128
constraint allset.rate_limits rate_limits_pkey p PRIMARYKEYbucket,key_hash,window_start
constraint allset.staff_devices staff_devices_pkey p PRIMARYKEYid
constraint allset.staff_devices staff_devices_staff_id_fkey f FOREIGNKEYstaff_idREFERENCESallset.staff_usersidONDELETECASCADE
constraint allset.staff_devices staff_devices_token_hash_key u UNIQUEtoken_hash
constraint allset.staff_mfa_challenges staff_mfa_challenges_device_id_fkey f FOREIGNKEYdevice_idREFERENCESallset.staff_devicesidONDELETESETNULL
constraint allset.staff_mfa_challenges staff_mfa_challenges_pkey p PRIMARYKEYid
constraint allset.staff_mfa_challenges staff_mfa_challenges_staff_id_fkey f FOREIGNKEYstaff_idREFERENCESallset.staff_usersidONDELETECASCADE
constraint allset.staff_mfa_challenges staff_mfa_challenges_token_hash_key u UNIQUEtoken_hash
constraint allset.staff_recovery_codes staff_recovery_codes_code_hash_key u UNIQUEcode_hash
constraint allset.staff_recovery_codes staff_recovery_codes_pkey p PRIMARYKEYid
constraint allset.staff_recovery_codes staff_recovery_codes_staff_id_fkey f FOREIGNKEYstaff_idREFERENCESallset.staff_usersidONDELETECASCADE
constraint allset.staff_sessions staff_sessions_pkey p PRIMARYKEYid
constraint allset.staff_sessions staff_sessions_staff_id_fkey f FOREIGNKEYstaff_idREFERENCESallset.staff_usersidONDELETECASCADE
constraint allset.staff_sessions staff_sessions_token_hash_key u UNIQUEtoken_hash
constraint allset.staff_sessions staff_sessions_user_agent_check c CHECKuser_agentISNULLORchar_lengthuser_agent<=256
constraint allset.staff_users staff_users_created_by_fkey f FOREIGNKEYcreated_byREFERENCESallset.staff_usersidONDELETESETNULL
constraint allset.staff_users staff_users_display_name_check c CHECKchar_lengthdisplay_name>=1ANDchar_lengthdisplay_name<=80
constraint allset.staff_users staff_users_email_check c CHECKchar_lengthemail>=3ANDchar_lengthemail<=254
constraint allset.staff_users staff_users_invite_token_hash_key u UNIQUEinvite_token_hash
constraint allset.staff_users staff_users_pkey p PRIMARYKEYid
constraint allset.staff_users staff_users_role_check c CHECKrole=ANYARRAY['owner'::text,'staff'::text]
constraint allset.webhook_events webhook_events_event_id_check c CHECKchar_lengthevent_id<=100
constraint allset.webhook_events webhook_events_event_type_check c CHECKchar_lengthevent_type<=64
constraint allset.webhook_events webhook_events_pkey p PRIMARYKEYevent_id
