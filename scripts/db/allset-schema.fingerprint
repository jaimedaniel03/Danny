index inquiries_reference_key CREATE UNIQUE INDEX inquiries_reference_key ON allset.inquiries USING btree (reference)
index lead_notes_lead_idx CREATE INDEX lead_notes_lead_idx ON allset.lead_notes USING btree (lead_id, created_at DESC)
index lead_notes_pkey CREATE UNIQUE INDEX lead_notes_pkey ON allset.lead_notes USING btree (id)
index leads_activity_idx CREATE INDEX leads_activity_idx ON allset.leads USING btree (last_activity_at)
index leads_assigned_idx CREATE INDEX leads_assigned_idx ON allset.leads USING btree (assigned_to, status)
index leads_follow_up_idx CREATE INDEX leads_follow_up_idx ON allset.leads USING btree (follow_up_on) WHERE (follow_up_on IS NOT NULL)
index leads_one_open_per_person CREATE UNIQUE INDEX leads_one_open_per_person ON allset.leads USING btree (kind, email_normalized) WHERE (closed_at IS NULL)
index leads_pkey CREATE UNIQUE INDEX leads_pkey ON allset.leads USING btree (id)
index leads_status_idx CREATE INDEX leads_status_idx ON allset.leads USING btree (status, created_at DESC)
index notification_recipients_confirm_token_hash_key CREATE UNIQUE INDEX notification_recipients_confirm_token_hash_key ON allset.notification_recipients USING btree (confirm_token_hash)
index notification_recipients_email_key CREATE UNIQUE INDEX notification_recipients_email_key ON allset.notification_recipients USING btree (lower(email))
index notification_recipients_pkey CREATE UNIQUE INDEX notification_recipients_pkey ON allset.notification_recipients USING btree (id)
index notifications_created_idx CREATE INDEX notifications_created_idx ON allset.notifications USING btree (created_at DESC)
index notifications_due_idx CREATE INDEX notifications_due_idx ON allset.notifications USING btree (status, next_attempt_at)
index notifications_lead_idx CREATE INDEX notifications_lead_idx ON allset.notifications USING btree (lead_id) WHERE (lead_id IS NOT NULL)
index notifications_pkey CREATE UNIQUE INDEX notifications_pkey ON allset.notifications USING btree (id)
index notifications_provider_message_id_key CREATE UNIQUE INDEX notifications_provider_message_id_key ON allset.notifications USING btree (provider_message_id)
index rate_limits_pkey CREATE UNIQUE INDEX rate_limits_pkey ON allset.rate_limits USING btree (bucket, key_hash, window_start)
index rate_limits_window_idx CREATE INDEX rate_limits_window_idx ON allset.rate_limits USING btree (window_start)
index staff_devices_pkey CREATE UNIQUE INDEX staff_devices_pkey ON allset.staff_devices USING btree (id)
index staff_devices_staff_idx CREATE INDEX staff_devices_staff_idx ON allset.staff_devices USING btree (staff_id)
index staff_devices_token_hash_key CREATE UNIQUE INDEX staff_devices_token_hash_key ON allset.staff_devices USING btree (token_hash)
index staff_mfa_challenges_pkey CREATE UNIQUE INDEX staff_mfa_challenges_pkey ON allset.staff_mfa_challenges USING btree (id)
index staff_mfa_challenges_token_hash_key CREATE UNIQUE INDEX staff_mfa_challenges_token_hash_key ON allset.staff_mfa_challenges USING btree (token_hash)
