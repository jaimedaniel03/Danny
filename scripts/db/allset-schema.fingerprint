index audit_events_entity_idx CREATE INDEX audit_events_entity_idx ON allset.audit_events USING btree (entity_type, entity_id, occurred_at DESC)
index audit_events_pkey CREATE UNIQUE INDEX audit_events_pkey ON allset.audit_events USING btree (id)
index audit_events_time_idx CREATE INDEX audit_events_time_idx ON allset.audit_events USING btree (occurred_at DESC)
index contact_suppressions_created_idx CREATE INDEX contact_suppressions_created_idx ON allset.contact_suppressions USING btree (created_at)
index contact_suppressions_pkey CREATE UNIQUE INDEX contact_suppressions_pkey ON allset.contact_suppressions USING btree (value_hash)
