schema-grant allset allset_app USAGE
trigger allset.audit_events audit_events_append_only CREATE TRIGGER audit_events_append_only BEFORE DELETE OR UPDATE ON allset.audit_events FOR EACH ROW EXECUTE FUNCTION allset.audit_append_only()
trigger allset.inquiries inquiries_no_update CREATE TRIGGER inquiries_no_update BEFORE UPDATE ON allset.inquiries FOR EACH ROW EXECUTE FUNCTION allset.reject_update()
trigger allset.lead_notes lead_notes_no_update CREATE TRIGGER lead_notes_no_update BEFORE UPDATE ON allset.lead_notes FOR EACH ROW EXECUTE FUNCTION allset.reject_update()
