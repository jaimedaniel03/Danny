index staff_recovery_codes_staff_idx CREATE INDEX staff_recovery_codes_staff_idx ON allset.staff_recovery_codes USING btree (staff_id)
index staff_sessions_expiry_idx CREATE INDEX staff_sessions_expiry_idx ON allset.staff_sessions USING btree (expires_at)
index staff_sessions_pkey CREATE UNIQUE INDEX staff_sessions_pkey ON allset.staff_sessions USING btree (id)
